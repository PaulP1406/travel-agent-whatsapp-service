BRAIN_WEBHOOK_URL=http://localhost:8000/webhook/whatsapp
BRAIN_SHARED_SECRET=
BRAIN_TIMEOUT_MS=15000
PORT=3000
SERVICE_TOKEN=
GROUPS_ONLY=true
ALLOWED_GROUP_IDS=
SEND_MIN_GAP_MS=1500
SHOW_TYPING=true
FORWARD_MEDIA=false
# Solo testing only: lets you @tag yourself from your own linked phone and have
# it relay to the brain like a normal message. Keep false on a real deployment
# (burner number) — the agent should never treat its own chatter as input.
ALLOW_SELF_MESSAGES=false
AUTH_DATA_PATH=.wwebjs_auth
# macOS local dev (if Puppeteer's bundled Chromium wasn't installed): /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux servers / Docker: /usr/bin/chromium
CHROME_PATH=
HEADLESS=true
LOG_LEVEL=info
